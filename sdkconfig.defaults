# Enable Bluetooth and use the lightweight NimBLE host stack (BLE-only).
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_CONTROLLER_MODE_BLE_ONLY=y

# Peripheral role only — saves RAM by excluding central/observer/broadcaster.
CONFIG_BT_NIMBLE_ROLE_CENTRAL_DISABLED=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER_DISABLED=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER_DISABLED=y

# Persist BLE bonding/peer data in NVS.
CONFIG_BT_NIMBLE_NVS_PERSIST=y

# Only one simultaneous connection needed for a sensor peripheral.
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1

# 1 ms FreeRTOS tick — improves BLE timing accuracy.
CONFIG_FREERTOS_HZ=1000

# Default log level.
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
